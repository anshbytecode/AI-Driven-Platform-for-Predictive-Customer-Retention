# Environment configuration for Meridian Retention Platform
PORT=5000
NODE_ENV=production

# Cloud PostgreSQL Connection URL (Provided automatically by Render, Railway, Neon, Supabase)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Or Individual PostgreSQL credentials (for self-hosted or AWS RDS)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=meridian_retention_db
PGSSL=true

